{#
/**
 * @file
 * Default theme implementation to output a Communico event.
 *
 * Available variables:
 *   - title
 *   - subTitle
 *   - ages
 *   - types
 *   - expire_date
 *   - branch_link
 *   - locationName
 *   - calendar_image_path
 *   - map_pin_image_path
 *   - reg_url
 *   - expired_text
 *   - description
 *   - one_image
 *
 * @ingroup themeable
 */
#}

<h1 class="page-title">
  {{ title }}
</h1>
<h2 class="node__title">
  {{ subTitle }}
</h2>
<div class="c-feature">
  <div class="c-iconimage">
    <img src="{{ map_pin_image_path }}" alt="Map pin icon">
  </div>
    <a href = "{{ branch_link }}" target="_new">{{ locationName }}</a>
</div>
<br>
<div class="c-feature">
  <div class="c-iconimage"><img src="{{ calendar_image_path }}" alt="Calendar Icon"></div>
  {{ expired_text }}
</div>
<br>
<div class="c-feature">
  <div class="c-title">Age Group:</div> {{ ages|join(', ') }}
</div>
<br>
<div class="c-feature">
  <div class="c-title">Event Type:</div> {{ types|join(', ') }}
</div>
<br>
<div class="c-feature">
<a href="{{ reg_url }}" target="_new">
<div id="event-sub-button">Register</div>
</a>
</div>
<p>
  {{ description }}
</p>
{{ one_image }}
